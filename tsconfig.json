{
  "compilerOptions": {
    "outDir": "./build",
    "rootDir": "./src",

    "module": "nodenext",
    "moduleResolution": "nodenext", 
    "target": "ES2020",

    "sourceMap": true,
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src"]
}
